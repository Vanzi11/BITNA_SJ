# Copie este arquivo para app/.env (uso local) e preencha os valores reais.
# app/.env NUNCA deve ser commitado (já está no .gitignore).
# No Railway, as mesmas variáveis vão no painel "Variables" do serviço — não
# como arquivo, o Railway injeta como variáveis de ambiente de verdade.

# Anthropic (geração do texto interpretativo do relatório) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend (envio de e-mail) — https://resend.com
RESEND_API_KEY=
# Opcional. Padrão: "Bitna Saju <contato@bitnasaju.com.br>" — só funciona com o
# domínio verificado no Resend. Antes disso, use "Bitna Saju <onboarding@resend.dev>".
EMAIL_REMETENTE=
# E-mail que recebe o aviso de "novo pedido" pra revisar. Padrão: contato@bitnasaju.com.br
EMAIL_IVA=

# Google Sheets (painel de pedidos) — conta de serviço do Google Cloud
# Uso local: caminho para o arquivo .json da credencial (baixado do Google Cloud Console).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# Uso no Railway: o CONTEÚDO desse .json colado direto aqui (não há arquivo local no servidor).
# Preencha só um dos dois — local usa KEY_PATH, Railway usa KEY_JSON.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# ID da planilha (fica na URL: docs.google.com/spreadsheets/d/ESTE_TRECHO/edit)
GOOGLE_SHEET_ID=
# Opcional. Nome da aba da planilha. Padrão: "Pedidos"
GOOGLE_SHEET_ABA=

# Hotmart (validação do webhook — ainda não implementado no server.mjs)
HOTMART_HOTTOK=

# URL pública do backend (usada pra montar o link de aprovação no e-mail).
# Local: deixe em branco, usa http://localhost:3333 automaticamente.
# Railway: a URL pública que o Railway atribuir ao serviço (ex.: https://xxx.up.railway.app)
BASE_URL=

# Porta em que o servidor escuta. Local: 3333 (padrão). Railway define isso sozinho — não mexer.
PORT=
